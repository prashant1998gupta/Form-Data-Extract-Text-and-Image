# FormLink — server environment. Copy to .env.local (which is gitignored).

# Reads the form. Required for scanning; without it the scan screen says so
# and the record can still be filled in by hand. Free tier:
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional. The vision model (default: qwen/qwen3.6-27b) and a Groq-compatible
# endpoint to send requests to (default: https://api.groq.com/openai/v1).
GROQ_MODEL=
GROQ_BASE_URL=

# Optional. At most this many scans reach the model per minute, per server
# instance (default 10; 0 disables the bound). The endpoint is unauthenticated,
# so a key on a public deployment is spend anyone can trigger — this is a
# brake, not a lock.
FORMLINK_MAX_SCANS_PER_MINUTE=

# ---------------------------------------------------------------------------
# Saving (optional). Without these, saved scans live in the browser that
# saved them — IndexedDB — and the app says so on screen.
# ---------------------------------------------------------------------------

# Your Supabase project's URL and a key. The service role key is SERVER-ONLY
# and never reaches a browser (lib/db/client.ts is `server-only`). The
# publishable key also works: the scans table's policies allow it.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
