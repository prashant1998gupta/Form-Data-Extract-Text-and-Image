# FormLink — server environment. Copy to .env.local (which is gitignored).
#
# Everything here is OPTIONAL. With no key set, the app runs exactly as before:
# the photo, signature and thumb impression are extracted with zero model
# calls, and the handwritten text fields are simply not read.

# Enables the handwriting reader via Groq. Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Enables the handwriting reader via Claude — the more accurate option.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Force one provider when both keys are set: "groq" or "anthropic".
# With both set and no preference, Claude is used.
FORMLINK_TEXT_PROVIDER=

# Optional. Override the provider's default model
# (groq default: qwen/qwen3.6-27b — anthropic default: claude-opus-5).
FORMLINK_TEXT_MODEL=

# Optional. How fields reach the model: "perField" (one request per field —
# the value-to-field mapping is structural and cannot be misattributed) or
# "composite" (every crop in one numbered image, one request per scan — the
# mode for token-per-minute-capped tiers like Groq's free tier, where eight
# requests can never fit but one can). Default: composite on Groq, perField
# on Anthropic.
FORMLINK_TEXT_MODE=

# Optional. At most this many scans reach the paid model per minute, per
# server instance (default 10; 0 disables the bound). The endpoint is
# unauthenticated, so a key on a public deployment is spend anyone can
# trigger — this is a brake, not a lock; see lib/reader/throttle.ts and the
# README before deploying with a key.
FORMLINK_TEXT_MAX_SCANS_PER_MINUTE=

# ---------------------------------------------------------------------------
# Persistence (optional). Without these the scanner runs exactly as before —
# crops, reading and review — and only publishing forms, saving records and
# the record views are unavailable, each saying so on screen.
# ---------------------------------------------------------------------------

# Your Supabase project's URL and service role key. The service role key is
# SERVER-ONLY and must never be exposed to a browser; lib/db/client.ts is
# marked `server-only` so a stray client import is a build error.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
